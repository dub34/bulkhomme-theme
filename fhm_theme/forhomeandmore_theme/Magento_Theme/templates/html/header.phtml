<!-- Mobile Overlay (for closing mobile menu) -->
<div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>

<script>
require([
    'jquery',
    'domReady!'
], function ($) {
    'use strict';

    // Mobile menu toggle
    $('#mobile-menu-toggle, #mobile-menu-overlay').on('click', function() {
        $('body').toggleClass('mobile-menu-open');
    });

    // Catalog button functionality
    $('#catalog-toggle').on('click', function() {
        // Toggle catalog/navigation visibility
        $('.navigation-menu').toggleClass('catalog-open');
    });

    // Close mobile menu when clicking outside
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.mobile-menu-toggle, .navigation-menu').length) {
            $('body').removeClass('mobile-menu-open');
        }
    });

    // Close mobile menu on ESC key
    $(document).on('keydown', function(e) {
        if (e.key === 'Escape' && $('body').hasClass('mobile-menu-open')) {
            $('body').removeClass('mobile-menu-open');
        }
    });
});
</script>
